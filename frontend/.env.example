VITE_API_URL=http://localhost:3001
VITE_APP_NAME=AfriHome
VITE_APP_URL=http://localhost:5173

# Supabase Realtime (chat typing indicators / live thread updates).
# The anon key is safe to expose client-side by design; broadcast payloads
# never carry message content, only "something changed" / typing signals.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=replace_me

# Web push notifications (optional — the notification bell still works via
# polling without this; only the closed-tab push permission prompt is hidden).
# Must match backend VAPID_PUBLIC_KEY.
VITE_VAPID_PUBLIC_KEY=replace_me
